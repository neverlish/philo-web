{
  "action": "rules.insert",
  "value": {
    "name": "Guest AI preview: 5 requests per 10 minutes",
    "description": "Limit guest AI generation before it reaches the function. Public reading and practice pages are excluded.",
    "active": true,
    "conditionGroup": [{ "conditions": [
      { "type": "path", "op": "eq", "value": "/api/prescription/preview" },
      { "type": "method", "op": "eq", "value": "POST" }
    ] }],
    "action": { "mitigate": {
      "action": "rate_limit",
      "rateLimit": { "algo": "fixed_window", "window": 600, "limit": 5, "keys": ["ip"], "action": "rate_limit" }
    } }
  }
}
